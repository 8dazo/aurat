{
  "name": "aurat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "aurat": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test src/*.test.js src/platform/*.test.js",
    "start": "node src/cli.js proxy",
    "demo": "node src/cli.js test --suite examples/ticket-agent/suite.json",
    "platform:init": "node src/platform/init.js",
    "platform:dev": "node --env-file-if-exists=.env --env-file-if-exists=.aurat/platform.env src/platform/start.js",
    "platform:mcp": "node --env-file-if-exists=.env --env-file-if-exists=.aurat/platform.env src/platform/stdio.js",
    "platform:test": "node --test src/platform/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mswjs/interceptors": "0.45.5",
    "ajv": "8.20.0"
  },
  "exports": {
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    }
  },
  "files": [
    "src",
    "!src/*.test.js",
    "examples/ticket-agent",
    "docs/scenario-runner.md",
    "docs/implementation-review.md",
    "README.md",
    "docs/brand"
  ]
}
