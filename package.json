{
  "name": "aurat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic CI runtime for AI applications",
  "bin": {
    "aurat": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
